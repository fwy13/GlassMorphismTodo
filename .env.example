# Host interface and public HTTP port (use HTTPS reverse proxy for production)
HOST_BIND=0.0.0.0
APP_PORT=8101

# Only used when the PostgreSQL volume is initialized for the first time.
POSTGRES_DB=glassmorphismtodo
POSTGRES_USER=glassmorphismtodo
# CHANGE THIS before deploying; use a unique long random secret.
POSTGRES_PASSWORD=replace-with-a-long-random-password
